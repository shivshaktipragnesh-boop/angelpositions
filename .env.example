# Angel One SmartAPI credentials (set these in Vercel > Project > Settings > Environment Variables)
ANGEL_API_KEY=your_smartapi_api_key
ANGEL_CLIENT_CODE=A123456
ANGEL_PIN=1234
ANGEL_TOTP_SECRET=YOURBASE32TOTPSECRET

# Long random string that protects your page. Open the app once with ?key=THIS_VALUE
APP_KEY=change-me-to-a-long-random-string

# Optional: SmartAPI wants these headers; dummy values normally work
# ANGEL_LOCAL_IP=192.168.1.10
# ANGEL_PUBLIC_IP=106.193.147.98
# ANGEL_MAC=fe80::216e:6507:4b90:3719
